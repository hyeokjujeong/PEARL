{
    "env_name": "ant-dir",
    "method": "flow",
    "n_train_tasks": 2,
    "n_eval_tasks": 2,
    "env_params": {
        "n_tasks": 2
    },
    "algo_params": {
        "meta_batch": 4,
        "num_initial_steps": 2000,
        "num_steps_prior": 400,
        "num_steps_posterior": 0,
        "num_extra_rl_steps_posterior": 600,
        "num_train_steps_per_itr": 4000,
        "num_evals": 4,
        "num_steps_per_eval": 600,
        "num_exp_traj_eval": 2,
        "use_information_bottleneck": false,
        "embedding_batch_size": 256,
        "embedding_mini_batch_size": 256
    },
    "flow_params": {
        "training_mode": "fusedVel+decoderCFM",
        "use_prior_flow": true,
        "prior_hidden": 128,
        "prior_weight": 1.0,
        "cfm_weight": 1.0,
        "cfm_warmup_steps": 0,
        "recon_weight": 1.0,
        "max_context": null
    },
    "util_params": {
        "use_wandb": true
    }
}
