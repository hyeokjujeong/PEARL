{
    "env_name": "point-robot",
    "method": "flow",
    "n_train_tasks": 80,
    "n_eval_tasks": 20,
    "env_params": {
        "n_tasks": 100
    },
    "algo_params": {
        "num_initial_steps": 200,
        "num_steps_prior": 200,
        "num_steps_posterior": 0,
        "num_extra_rl_steps_posterior": 200,
        "num_train_steps_per_itr": 1000,
        "num_steps_per_eval": 60,
        "max_path_length": 20,
        "reward_scale": 100.0,
        "kl_lambda": 0.1,
        "use_information_bottleneck": false,
        "embedding_batch_size": 64,
        "embedding_mini_batch_size": 64
    },
    "flow_params": {
        "training_mode": "paper",
        "use_prior_flow": true,
        "prior_hidden": 128,
        "prior_weight": 1.0,
        "cfm_weight": 1.0,
        "cfm_warmup_steps": 0,
        "recon_weight": 0.0,
        "max_context": null
    },
    "util_params": {
        "use_wandb": true
    }
}
