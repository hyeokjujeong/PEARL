{
    "env_name": "point-robot",
    "n_train_tasks": 2,
    "n_eval_tasks": 2,
    "latent_size": 5,
    "net_size": 64,
    "method": "varibad",
    "env_params": {
        "n_tasks": 4,
        "randomize_tasks": true
    },
    "algo_params": {
        "max_path_length": 20,
        "num_evals": 1,
        "num_steps_per_eval": 40
    },
    "varibad_params": {
        "max_rollouts_per_task": 2,
        "max_path_length": 20,
        "num_tasks_per_update": 2,
        "policy_num_steps": 80,
        "num_frames": 160,
        "num_evals": 1,
        "num_steps_per_eval": 40,
        "ppo_num_epochs": 1,
        "ppo_num_minibatch": 2,
        "policy_layers": [64, 64],
        "pass_latent_to_policy": false,
        "decode_reward": false,
        "decode_state": false,
        "disable_decoder": true,
        "disable_kl_term": true,
        "append_done_to_obs": true,
        "append_done_to_encoder": false,
        "norm_rew_for_policy": false,
        "norm_state_for_policy": false
    },
    "util_params": {
        "use_gpu": false,
        "debug": true
    }
}

