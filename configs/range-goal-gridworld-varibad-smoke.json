{
    "env_name": "range-goal-gridworld-ambiguous",
    "method": "varibad",
    "n_train_tasks": 4,
    "n_eval_tasks": 2,
    "latent_size": 5,
    "net_size": 64,
    "env_params": {
        "n_tasks": 6,
        "randomize_tasks": false,
        "size": 15,
        "horizon": 30,
        "map_family": "ambiguous",
        "bin_edges": [0, 5, 10, 15, 20],
        "min_start_goal_dist": 8,
        "min_initial_support": 16,
        "min_initial_modes": 2,
        "include_oracle_in_info": false
    },
    "algo_params": {
        "max_path_length": 30,
        "num_evals": 1,
        "num_steps_per_eval": 60
    },
    "varibad_params": {
        "max_rollouts_per_task": 2,
        "max_path_length": 30,
        "num_tasks_per_update": 2,
        "policy_num_steps": 120,
        "num_frames": 240,
        "num_evals": 1,
        "num_steps_per_eval": 60,
        "eval_shuffled_latent": true,

        "ppo_num_epochs": 1,
        "ppo_num_minibatch": 2,
        "ppo_clip_param": 0.1,
        "ppo_log_ratio_clip": 20.0,
        "lr_policy": 0.0001,
        "policy_init_std": 0.5,
        "policy_logstd_min": -5.0,
        "policy_logstd_max": 1.0,
        "policy_mean_clip": 10.0,

        "policy_layers": [64, 64],
        "reward_decoder_layers": [64, 64],
        "state_decoder_layers": [64, 64],
        "encoder_gru_hidden_size": 64,
        "vae_batch_num_trajs": 2,
        "size_vae_buffer": 100,
        "num_vae_updates": 1,

        "append_done_to_obs": true,
        "append_done_to_encoder": false,
        "latent_input_mode": "mean_logvar",
        "norm_rew_for_policy": true,
        "norm_state_for_policy": true,
        "norm_latent_for_policy": true
    },
    "util_params": {
        "use_gpu": false,
        "debug": true,
        "use_wandb": false
    }
}
